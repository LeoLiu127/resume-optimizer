# =========================================================
# 简历专家 - MiniMax API 配置
# 警告：Vite 会把 VITE_ 开头的变量打包进前端代码，
# 请仅填入受控的 API Key，避免把生产私密 Key 直接提交到仓库。
#
# 安全 / CORS 提示：
#  - 本项目是纯前端，API Key 会出现在构建产物中，请使用“受限额度 Key”。
#  - 浏览器跨域调用 https://api.minimaxi.com 可能被 CORS 拦截。
#    如报错 “CORS / Access-Control-Allow-Origin”，需使用官方允许的
#    跨域路径、或自行转发代理（Vite devServer.proxy 或 Nginx）。
#  - 如暂不接入 AI，将 VITE_USE_MOCK_FALLBACK 设为 true 即可走本地 Mock。
# =========================================================

# MiniMax 开放平台申请的 API Key（必填）
VITE_MINIMAX_API_KEY=eyJhbGciOi...请替换成自己的 Key

# OpenAI 兼容协议 base_url，默认无需修改
VITE_MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 模型名称，默认 MiniMax-M3
VITE_MINIMAX_MODEL=MiniMax-M3

# 单次请求超时（毫秒），默认 60000
VITE_MINIMAX_TIMEOUT=60000

# 是否启用本地 mock 作为兜底（true / false）
VITE_USE_MOCK_FALLBACK=true