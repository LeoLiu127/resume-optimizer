# =========================================================
# 简历优化大师后端配置（不入库，参考 .env.example）
# =========================================================

# 服务端口
PORT=4000

# 跨域白名单（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173

# MiniMax API 配置（关键！不要再泄露给前端）
MINIMAX_API_KEY=eyJhbGciOi...请替换为你的真实 Key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT=60000

# 邀请码长度（生成时随机字符数）
INVITE_CODE_LENGTH=10

# Token 有效期（天）
TOKEN_TTL_DAYS=30

# 是否启用邀请码（生产建议 true）
INVITE_ONLY=true
